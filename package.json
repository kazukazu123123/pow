{
  "name": "pow",
  "version": "3.15.2",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node .",
    "dev": "run-p build:debug:watch dev:run",
    "db:generate": "prisma generate",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "dev:run": "node --watch -r dotenv/config . dotenv_config_override=true",
    "build": "swc src --copy-files --out-dir dist",
    "build:debug": "swc --source-maps=true src --out-dir=dist",
    "build:debug:watch": "swc --watch --source-maps=true src --out-dir=dist",
    "format": "oxfmt --disable-nested-config --write",
    "format:check": "oxfmt --disable-nested-config --check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check:types": "tsc",
    "prepare": "node .husky/install.mjs"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@prisma/client": "6.19.3",
    "@sapphire/framework": "5.5.1",
    "@sapphire/plugin-subcommands": "7.0.1",
    "@snazzah/davey": "0.1.12",
    "bufferutil": "4.1.0",
    "debug": "4.4.1",
    "discord-emoji": "2.5.3",
    "discord.js": "14.27.0",
    "emoji-regex": "10.6.0",
    "ffmpeg-static": "5.3.0",
    "mariadb": "3.5.3",
    "zlib-sync": "0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/debug": "4.1.12",
    "@types/node": "24.19.1",
    "chokidar": "5.0.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.72.0",
    "prisma": "6.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0"
  },
  "author": "kazukazu123123",
  "license": "MIT",
  "description": "",
  "type": "module"
}
